{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CPAS Metadata",
  "type": "object",
  "properties": {
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "multipleOf": 0.001
    },
    "rifg": {
      "type": "number",
      "enum": [0.0, 0.25, 0.5, 0.75, 1.0]
    },
    "provenance": {
      "type": "array",
      "items": {"type": "string"}
    },
    "notes": {"type": "string"}
  },
  "required": ["confidence", "rifg", "provenance"],
  "additionalProperties": false
}
